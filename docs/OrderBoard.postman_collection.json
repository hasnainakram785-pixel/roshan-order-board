{
  "info": {
    "name": "Roshan Order Board API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "List all orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Expect 200 and a JSON array."
      }
    },
    {
      "name": "List orders by status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders?status=pending",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "status",
              "value": "pending"
            }
          ]
        },
        "description": "Expect 200 and only pending orders."
      }
    },
    {
      "name": "Get one order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1"
          ]
        },
        "description": "Expect 200 and one JSON object."
      }
    },
    {
      "name": "Get missing order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "9999"
          ]
        },
        "description": "Expect 404 JSON."
      }
    },
    {
      "name": "Update status (valid)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1"
          ]
        },
        "description": "Expect 200 and the updated order.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update status (invalid)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1"
          ]
        },
        "description": "Expect 422 with a validation error.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"banana\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update status (missing)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "1"
          ]
        },
        "description": "Expect 422 with a validation error.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}