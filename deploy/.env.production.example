APP_NAME="Roshan Order Board"
APP_ENV=production
APP_KEY=__FILLED_BY_BUILD_SCRIPT__
APP_DEBUG=false
APP_URL=https://YOUR-API-HOST

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database details come from your host's control panel (MySQL Databases page)
DB_CONNECTION=mysql
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# Shared hosting has no queue worker or Redis
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Your Netlify address (no trailing slash). Several: separate with commas.
CORS_ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
